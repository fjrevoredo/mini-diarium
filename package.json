{
  "name": "mini-diarium",
  "version": "0.5.2",
  "description": "A modern, encrypted, local-first desktop journaling application",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "bun scripts/tauri-dev.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "node scripts/pre-commit.js",
    "check": "node scripts/quick-check.js",
    "diagrams": "node scripts/render-diagrams.mjs",
    "diagrams:check": "node scripts/verify-diagrams.mjs",
    "website:blog": "node scripts/generate-website-blog.mjs",
    "website:docs": "node scripts/generate-website-docs.mjs",
    "website:build-static": "node scripts/generate-website-blog.mjs && node scripts/generate-website-docs.mjs && node scripts/fingerprint-website-assets.mjs",
    "website:submit-indexnow": "node scripts/submit-indexnow.mjs",
    "website:submit-indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run",
    "website:fingerprint": "node scripts/fingerprint-website-assets.mjs",
    "test:e2e": "node scripts/run-e2e.js clean",
    "test:e2e:stateful": "node scripts/run-e2e.js stateful",
    "test:e2e:local": "node scripts/e2e-local.js",
    "validate:locales": "npx tsx scripts/validate-locales.ts",
    "sync-languages": "npx tsx scripts/sync-languages.ts",
    "agent:dev:start": "npx tsx scripts/agent-dev/start.ts",
    "agent:dev:stop": "npx tsx scripts/agent-dev/stop.ts",
    "agent:dev:probe": "npx tsx scripts/agent-dev/probe.ts",
    "bench": "vitest bench",
    "sync-skills": "node scripts/sync-skills.js",
    "check:ui-errors": "node scripts/check-ui-error-sanitization.js"
  },
  "license": "MIT",
  "puppeteer": {
    "skipDownload": true
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "^11.1.1",
    "basic-ftp": "^5.3.1",
    "mermaid": "11.15.0"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/i18n": "^2.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "dompurify": "^3.4.5",
    "lucide-solid": "^1.16.0",
    "marked": "^18.0.4",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "11.15.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.1",
    "@unocss/reset": "^66.7.0",
    "@unocss/vite": "^66.7.0",
    "@vitest/ui": "^4.1.7",
    "@wdio/cli": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/types": "^9.27.1",
    "eslint": "^10.4.0",
    "eslint-plugin-solid": "^0.14.5",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "unocss": "^66.7.0",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7",
    "webdriverio": "^9.27.1"
  }
}
