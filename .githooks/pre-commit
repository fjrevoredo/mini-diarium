#!/usr/bin/env bash
# Auto-installed by scripts/install-hooks.js (via `bun install` → postinstall).
# Formats staged frontend and backend files so style violations never reach the repo.
# Bypass with: git commit --no-verify
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR) || exit 0
[ -z "$STAGED" ] && exit 0

FRONTEND_FILES=$(echo "$STAGED" | grep -E '^src/.*\.(ts|tsx|css)$' || true)
if [ -n "$FRONTEND_FILES" ]; then
  echo "pre-commit: formatting staged frontend files with Prettier..."
  bunx prettier --write $FRONTEND_FILES
  git add $FRONTEND_FILES
fi

# Match staged Rust in both the app crate (src-tauri/) and the mini-diarium-core
# crate (crates/); `cargo fmt --all` formats every workspace member from root.
BACKEND_FILES=$(echo "$STAGED" | grep -E '^(src-tauri|crates)/.*\.rs$' || true)
if [ -n "$BACKEND_FILES" ]; then
  if command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: formatting Rust workspace with cargo fmt --all..."
    cargo fmt --all
    git add $BACKEND_FILES
  else
    echo "pre-commit: cargo not in PATH; skipping rust formatting (run: cargo fmt --all)" >&2
  fi
fi

exit 0