direction: right

presentation: {
  label: "Presentation Layer\n(SolidJS Components)"
  style.fill: "#1E293B"
  style.stroke: "#38BDF8"

  app: "App.tsx\n(Switch / Match by authState)"
  journal_ui: "JournalPicker\n(select/manage journals)"
  auth_ui: "Unlock + Setup Screens\n(PasswordCreation / PasswordPrompt)"
  editor_ui: "MainLayout\n(Calendar + Editor + Overlays)"
}

state: {
  label: "State Layer\n(Solid Signals)"
  style.fill: "#312E81"

  auth_state: "auth.ts"
  entry_state: "entries.ts"
  journal_state: "journals.ts"
  search_state: "search.ts\n(in-memory scan)"
  ui_state: "ui.ts"
  pref_state: "preferences.ts"
}

ipc: {
  label: "IPC Layer"
  style.fill: "#064E3B"

  invoke: "invoke() / listen()"
}

backend: {
  label: "Rust Backend\n(Cargo workspace)"
  style.fill: "#292524"

  app_crate: "App crate — src-tauri/\ncommands (auth, entries, search, nav,\nstats, import, export, plugin)\nmenu.rs · OS shell"
  core_crate: "Core crate — mini-diarium-core\ndb · import · export · plugin · search\nbackup · config (Tauri-free)"
  crypto_crate: "Crypto crate — mini-diarium-crypto\ncipher · password hashing\nmaster-key wrapping (rusqlite-free)"
}

data: {
  label: "Data Layer"
  style.fill: "#111827"

  diary_db: "SQLite diary.db\nentries (encrypted)\nauth_slots (wrapped master keys)"
  backups: "Local backups/"
  journal_config: "config.json\njournal list + active journal"
  plugins_dir: "plugins/\nRhai user plugins"
  prefs: "Browser localStorage\n(non-sensitive preferences)"
}

presentation.app -> presentation.journal_ui
presentation.app -> presentation.auth_ui
presentation.app -> presentation.editor_ui
presentation.journal_ui -> state.journal_state
presentation.auth_ui -> state.auth_state
presentation.editor_ui -> state.entry_state
presentation.editor_ui -> state.search_state
presentation.editor_ui -> state.ui_state
presentation.editor_ui -> state.pref_state

state.auth_state -> ipc.invoke
state.entry_state -> ipc.invoke
state.journal_state -> ipc.invoke
state.search_state -> ipc.invoke
state.ui_state -> ipc.invoke

ipc.invoke -> backend.app_crate

backend.app_crate -> backend.core_crate
backend.core_crate -> backend.crypto_crate
backend.core_crate -> data.diary_db
backend.core_crate -> data.backups
backend.core_crate -> data.journal_config
backend.core_crate -> data.plugins_dir
state.pref_state -> data.prefs
